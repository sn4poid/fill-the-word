# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Optional. With a key, bracketed words get suggestions from gpt-4o-mini;
# without one, the built-in dictionary answers instead.
# OPENAI_API_KEY=""

# Optional. Signs the session cookie. A deployment should set it; without it the
# development key in src/auth/session.ts is used.
# AUTH_SECRET=""
